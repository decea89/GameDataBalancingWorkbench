<Application x:Class="BalanceForge.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BalanceForge.Desktop"
             xmlns:converters="clr-namespace:BalanceForge.Desktop.Converters">
    <Application.Resources>
        <converters:SeverityToColorConverter x:Key="SeverityToColorConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
    </Application.Resources>
</Application>

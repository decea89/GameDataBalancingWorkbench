<Window x:Class="BalanceForge.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BalanceForge.Desktop"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="600" Width="900">
    <Grid>
        <DockPanel>
            <!-- Top toolbar -->
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="10" Height="Auto">
                <Button Command="{Binding SelectFileCommand}" Padding="10,5" Margin="0,0,10,0">
                    Select File
                </Button>
                <Button Command="{Binding LoadCommand}" Padding="10,5">
                    Load
                </Button>
                <TextBlock Text="{Binding SelectedFilePath}" Margin="10,0" VerticalAlignment="Center" Foreground="Gray" FontSize="11"/>
            </StackPanel>

            <!-- Main content area -->
            <Grid DockPanel.Dock="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Status/Error area -->
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="10" VerticalAlignment="Top">
                    <TextBlock>
                        <Run Text="Units loaded: " Foreground="Black" />
                        <Run Text="{Binding LoadedUnitCount}" Foreground="Green" FontWeight="Bold" />
                    </TextBlock>
                    <TextBlock Margin="0,5,0,0">
                        <Run Text="Validation issues: " Foreground="Black" />
                        <Run Text="{Binding ValidationIssueCount}" Foreground="Orange" FontWeight="Bold" />
                    </TextBlock>
                </StackPanel>

                <!-- Error message -->
                <TextBlock Grid.Row="1" Grid.Column="0" Margin="10" Foreground="Red" TextWrapping="Wrap">
                    <Run Text="Error: " FontWeight="Bold" />
                    <Run Text="{Binding ErrorMessage}" />
                </TextBlock>
            </Grid>

            <!-- Status bar -->
            <StatusBar DockPanel.Dock="Bottom">
                <StatusBarItem>
                    <TextBlock Text="{Binding IsLoading, StringFormat='Loading: {0}'}" />
                </StatusBarItem>
            </StatusBar>
        </DockPanel>
    </Grid>
</Window>

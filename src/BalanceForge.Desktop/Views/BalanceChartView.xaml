<UserControl
    x:Class="BalanceForge.Desktop.Views.BalanceChartView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#F5F5F5">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock
            Grid.Row="0"
            FontSize="12"
            FontWeight="Bold"
            Foreground="#333"
            Text="Unit Balance Metrics" />

        <!-- Empty State -->
        <TextBlock
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="11"
            Foreground="#999"
            Text="No units selected. Filter or select units to view their metrics."
            Visibility="{Binding HasData, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
            x:Name="EmptyStateMessage" />

        <!-- Data Info -->
        <ItemsControl
            Grid.Row="1"
            x:Name="ChartInfo"
            ItemsSource="{Binding ChartData}"
            Visibility="{Binding HasData, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,4,0,4" BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" FontSize="10" FontWeight="Bold" Text="{Binding UnitName}" />
                            <TextBlock Grid.Column="1" FontSize="10" Foreground="#2E75B6" Text="{Binding TotalCost, StringFormat='Cost: {0}'}" />
                            <TextBlock Grid.Column="2" FontSize="10" Foreground="#C5504C" Text="{Binding DPS, StringFormat='DPS: {0:F1}'}" />
                            <TextBlock Grid.Column="3" FontSize="10" Foreground="#70AD47" Text="{Binding EffectiveHealth, StringFormat='EH: {0:F1}'}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>

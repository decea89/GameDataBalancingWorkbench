<UserControl
    x:Class="BalanceForge.Desktop.Views.BalanceChartView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#F4F5F7">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock FontSize="14"
                       FontWeight="Bold"
                       Foreground="#252A31"
                       Text="Unit Overview" />
            <TextBlock Margin="14,1,0,0"
                       FontSize="11"
                       Foreground="#6B7280"
                       Text="{Binding OutlierCount, StringFormat='Diagnostics: {0} flagged'}" />
        </StackPanel>

        <!-- Empty State -->
        <TextBlock
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="11"
            Foreground="#999"
            Text="No units match the current filters."
            Visibility="{Binding HasData, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
            x:Name="EmptyStateMessage" />

        <ScrollViewer Grid.Row="1"
                      Margin="0,10,0,0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasData, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ItemsControl x:Name="ChartInfo" ItemsSource="{Binding ChartData}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="330"
                                MinHeight="116"
                                Margin="0,0,10,10"
                                Padding="10"
                                Background="White"
                                BorderBrush="#D6D9DE"
                                BorderThickness="1"
                                CornerRadius="4">
                            <Border.ToolTip>
                                <ToolTip>
                                    <StackPanel MinWidth="230">
                                        <TextBlock FontWeight="Bold"
                                                   Text="{Binding UnitName}" />
                                        <TextBlock Margin="0,5,0,0"
                                                   Text="{Binding TotalCost, StringFormat='Total Cost: {0:F0}'}" />
                                        <TextBlock Text="{Binding DPS, StringFormat='DPS: {0:F1}'}" />
                                        <TextBlock Text="{Binding EffectiveHealth, StringFormat='Effective Health: {0:F1}'}" />
                                        <Separator Margin="0,5" />
                                        <TextBlock FontWeight="SemiBold"
                                                   Foreground="{Binding DiagnosticColor}"
                                                   Text="{Binding DiagnosticStatus}" />
                                        <TextBlock MaxWidth="320"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding DiagnosticInsight}" />
                                    </StackPanel>
                                </ToolTip>
                            </Border.ToolTip>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="90"
                                        Height="90"
                                        Background="#E7EAEE"
                                        BorderBrush="#C5CAD1"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        ClipToBounds="True">
                                    <Grid>
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="26"
                                                   FontWeight="SemiBold"
                                                   Foreground="#69717D"
                                                   Text="{Binding UnitInitial}"
                                                   Visibility="{Binding HasImage, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                        <Image Source="{Binding ImageSourcePath, Converter={StaticResource ImagePathToImageSourceConverter}}"
                                               Stretch="UniformToFill"
                                               Visibility="{Binding HasImage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="12,2,0,0">
                                    <TextBlock FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#252A31"
                                               Text="{Binding UnitName}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Margin="0,7,0,0"
                                               FontSize="11"
                                               Foreground="#365F87"
                                               Text="{Binding TotalCost, StringFormat='Cost  {0:F0}'}" />
                                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                        <Border Padding="5,1"
                                                Background="#F3F4F6"
                                                BorderBrush="{Binding DiagnosticColor}"
                                                BorderThickness="1"
                                                CornerRadius="3">
                                            <TextBlock FontSize="9"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding DiagnosticColor}"
                                                       Text="{Binding DiagnosticStatus}" />
                                        </Border>
                                        <TextBlock Margin="7,2,0,0"
                                                   Width="132"
                                                   FontSize="9"
                                                   Foreground="#5B626C"
                                                   Text="{Binding DiagnosticInsight}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding DiagnosticInsight}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                        <TextBlock FontSize="11"
                                                   Foreground="#9A3D3A"
                                                   Text="{Binding DPS, StringFormat='DPS  {0:F1}'}" />
                                        <TextBlock Margin="14,0,0,0"
                                                   FontSize="11"
                                                   Foreground="#47743B"
                                                   Text="{Binding EffectiveHealth, StringFormat='EH  {0:F1}'}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>

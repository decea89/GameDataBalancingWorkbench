<UserControl
    x:Class="BalanceForge.Desktop.Views.BalanceChartView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#F4F5F7">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock
            Grid.Row="0"
            FontSize="14"
            FontWeight="Bold"
            Foreground="#252A31"
            Text="Unit Overview" />

        <!-- Empty State -->
        <TextBlock
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="11"
            Foreground="#999"
            Text="No units match the current filters."
            Visibility="{Binding HasData, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
            x:Name="EmptyStateMessage" />

        <ScrollViewer Grid.Row="1"
                      Margin="0,10,0,0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasData, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ItemsControl x:Name="ChartInfo" ItemsSource="{Binding ChartData}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="310"
                                Height="96"
                                Margin="0,0,10,10"
                                Padding="10"
                                Background="White"
                                BorderBrush="#D6D9DE"
                                BorderThickness="1"
                                CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="72"
                                        Height="72"
                                        Background="#E7EAEE"
                                        BorderBrush="#C5CAD1"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        ClipToBounds="True">
                                    <Grid>
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="26"
                                                   FontWeight="SemiBold"
                                                   Foreground="#69717D"
                                                   Text="{Binding UnitInitial}"
                                                   Visibility="{Binding HasImage, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                        <Image Source="{Binding ImageSourcePath}"
                                               Stretch="UniformToFill"
                                               Visibility="{Binding HasImage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="12,1,0,0">
                                    <TextBlock FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#252A31"
                                               Text="{Binding UnitName}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Margin="0,7,0,0"
                                               FontSize="11"
                                               Foreground="#365F87"
                                               Text="{Binding TotalCost, StringFormat='Cost  {0:F0}'}" />
                                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                        <TextBlock FontSize="11"
                                                   Foreground="#9A3D3A"
                                                   Text="{Binding DPS, StringFormat='DPS  {0:F1}'}" />
                                        <TextBlock Margin="14,0,0,0"
                                                   FontSize="11"
                                                   Foreground="#47743B"
                                                   Text="{Binding EffectiveHealth, StringFormat='EH  {0:F1}'}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>

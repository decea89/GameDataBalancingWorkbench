<UserControl x:Class="BalanceForge.Desktop.Views.BalanceChartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             xmlns:local="clr-namespace:BalanceForge.Desktop.Views"
             Background="White"
             Margin="0">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Empty State -->
        <TextBlock Grid.Row="0" Grid.RowSpan="3" 
                   Text="No units to display. Load a roster and apply filters to see the chart."
                   VerticalAlignment="Center" 
                   HorizontalAlignment="Center"
                   Foreground="Gray"
                   FontSize="12"
                   Visibility="{Binding HasData, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />

        <!-- Chart Title -->
        <TextBlock Grid.Row="0" Text="{Binding ChartTitle}" FontSize="14" FontWeight="Bold" Margin="10,10,10,5" />

        <!-- LiveCharts2 Chart -->
        <lvc:CartesianChart Grid.Row="1" 
                            Margin="10,0,10,10"
                            Series="{Binding SeriesCollection}"
                            Visibility="{Binding HasData, Converter={StaticResource BooleanToVisibilityConverter}}">
            <lvc:CartesianChart.XAxes>
                <lvc:Axis Labels="{Binding Labels}" />
            </lvc:CartesianChart.XAxes>
            <lvc:CartesianChart.YAxes>
                <lvc:Axis Title="Value" />
            </lvc:CartesianChart.YAxes>
            <lvc:CartesianChart.LegendLocation>Top</lvc:CartesianChart.LegendLocation>
        </lvc:CartesianChart>

        <!-- Footer Info -->
        <TextBlock Grid.Row="2" Text="Total Cost (blue), DPS (red), Effective Health (green)" 
                   FontSize="10" Foreground="Gray" Margin="10,5,10,10"
                   Visibility="{Binding HasData, Converter={StaticResource BooleanToVisibilityConverter}}" />
    </Grid>
</UserControl>

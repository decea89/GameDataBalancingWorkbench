<UserControl
    x:Class="BalanceForge.Desktop.Views.ComparisonView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Empty State -->
        <TextBlock
            Grid.Row="0"
            Grid.RowSpan="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="11"
            Foreground="#999"
            Text="{Binding ComparisonStatus}"
            Visibility="{Binding HasComparison, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />

        <!-- Header -->
        <StackPanel
            Grid.Row="0"
            Margin="10,8,10,4"
            Orientation="Horizontal"
            Visibility="{Binding HasComparison, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock
                FontSize="12"
                FontWeight="Bold"
                Foreground="#333"
                Text="Unit Comparison" />
            <TextBlock
                Margin="8,0,0,0"
                FontSize="10"
                Foreground="#666"
                Text="{Binding ComparisonStatus}" />
        </StackPanel>

        <!-- Comparison Content -->
        <ScrollViewer
            Grid.Row="1"
            Margin="0,0,0,0"
            VerticalScrollBarVisibility="Auto"
            Visibility="{Binding HasComparison, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Margin="10" Orientation="Vertical">
                <!-- Unit Headers -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        FontSize="11"
                        FontWeight="Bold"
                        Foreground="#333"
                        Text="{Binding UnitA.DisplayName}" />
                    <TextBlock
                        Grid.Column="1"
                        FontSize="10"
                        Foreground="#999"
                        Margin="8,0,8,0"
                        Text="vs" />
                    <TextBlock
                        Grid.Column="2"
                        FontSize="11"
                        FontWeight="Bold"
                        Foreground="#333"
                        Text="{Binding UnitB.DisplayName}" />
                </Grid>

                <!-- Base Stats Section -->
                <StackPanel Orientation="Vertical" Margin="0,0,0,12">
                    <TextBlock
                        FontSize="10"
                        FontWeight="Bold"
                        Foreground="#666"
                        Margin="0,0,0,6"
                        Text="BASE STATS" />
                    <ItemsControl ItemsSource="{Binding BaseStats}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Unit A Value -->
                                    <TextBlock
                                        Grid.Column="0"
                                        FontSize="10"
                                        Foreground="#333"
                                        Text="{Binding DisplayValueA}" />
                                    <!-- Stat Name -->
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="8,0,8,0"
                                        FontSize="10"
                                        Foreground="#666"
                                        Text="{Binding Name}" />
                                    <!-- Winner Indicator -->
                                    <TextBlock
                                        Grid.Column="2"
                                        FontSize="10"
                                        Foreground="#C55"
                                        Text="{Binding WinnerLabel}" />
                                    <!-- Unit B Value -->
                                    <TextBlock
                                        Grid.Column="4"
                                        FontSize="10"
                                        Foreground="#333"
                                        Text="{Binding DisplayValueB}"
                                        TextAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Divider -->
                <Border BorderBrush="#DDD" BorderThickness="0,1,0,0" Margin="0,0,0,12" />

                <!-- Metrics Section -->
                <StackPanel Orientation="Vertical" Margin="0,0,0,12">
                    <TextBlock
                        FontSize="10"
                        FontWeight="Bold"
                        Foreground="#666"
                        Margin="0,0,0,6"
                        Text="DERIVED METRICS" />
                    <ItemsControl ItemsSource="{Binding DerivedMetrics}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Unit A Value -->
                                    <TextBlock
                                        Grid.Column="0"
                                        FontSize="10"
                                        Foreground="#333"
                                        Text="{Binding DisplayValueA}" />
                                    <!-- Metric Name -->
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="8,0,8,0"
                                        FontSize="10"
                                        Foreground="#666"
                                        Text="{Binding Name}" />
                                    <!-- Winner Indicator -->
                                    <TextBlock
                                        Grid.Column="2"
                                        FontSize="10"
                                        Foreground="#C55"
                                        Text="{Binding WinnerLabel}" />
                                    <!-- Unit B Value -->
                                    <TextBlock
                                        Grid.Column="4"
                                        FontSize="10"
                                        Foreground="#333"
                                        Text="{Binding DisplayValueB}"
                                        TextAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Related Issues Section -->
                <StackPanel Orientation="Vertical" Margin="0,0,0,0">
                    <TextBlock
                        FontSize="10"
                        FontWeight="Bold"
                        Foreground="#666"
                        Margin="0,0,0,6"
                        Text="VALIDATION ISSUES" />
                    <TextBlock
                        FontSize="10"
                        Foreground="#999"
                        Text="{Binding RelatedIssuesMessage}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
<UserControl
    x:Class="BalanceForge.Desktop.Views.ComparisonView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Empty State -->
        <TextBlock
            Grid.Row="0"
            Grid.RowSpan="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="11"
            Foreground="#999"
            Text="{Binding ComparisonStatus}"
            Visibility="{Binding HasComparison, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />

        <!-- Header -->
        <StackPanel
            Grid.Row="0"
            Margin="10,8,10,4"
            Orientation="Horizontal"
            Visibility="{Binding HasComparison, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock
                FontSize="12"
                FontWeight="Bold"
                Foreground="#333"
                Text="Unit Comparison" />
            <TextBlock
                Margin="8,0,0,0"
                FontSize="10"
                Foreground="#666"
                Text="{Binding ComparisonStatus}" />
        </StackPanel>

        <!-- Comparison Content -->
        <ScrollViewer
            Grid.Row="1"
            Margin="0,0,0,0"
            VerticalScrollBarVisibility="Auto"
            Visibility="{Binding HasComparison, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Margin="10" Orientation="Vertical" Spacing="12">
                <!-- Unit Headers -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        FontSize="11"
                        FontWeight="Bold"
                        Foreground="#333"
                        Text="{Binding UnitA.DisplayName}" />
                    <TextBlock
                        Grid.Column="1"
                        FontSize="10"
                        Foreground="#999"
                        Text="vs" />
                    <TextBlock
                        Grid.Column="2"
                        FontSize="11"
                        FontWeight="Bold"
                        Foreground="#333"
                        Text="{Binding UnitB.DisplayName}" />
                </Grid>

                <!-- Base Stats Section -->
                <StackPanel Orientation="Vertical" Spacing="6">
                    <TextBlock
                        FontSize="10"
                        FontWeight="Bold"
                        Foreground="#666"
                        Text="BASE STATS" />
                    <ItemsControl
                        x:Name="StatsItemsControl"
                        ItemsSource="{Binding BaseStats}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Unit A Value -->
                                    <TextBlock
                                        Grid.Column="0"
                                        FontSize="10"
                                        Foreground="#333"
                                        Text="{Binding DisplayValueA}">
                                        <TextBlock.FontWeight>
                                            <MultiBinding Converter="{StaticResource WinnerToBoldConverter}">
                                                <Binding Path="Winner" />
                                                <Binding Source="-1" />
                                            </MultiBinding>
                                        </TextBlock.FontWeight>
                                    </TextBlock>
                                    <!-- Stat Name -->
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="8,0,8,0"
                                        FontSize="10"
                                        Foreground="#666"
                                        Text="{Binding Name}" />
                                    <!-- Winner Indicator -->
                                    <TextBlock
                                        Grid.Column="2"
                                        FontSize="10"
                                        Foreground="#C55"
                                        Text="{Binding WinnerLabel}" />
                                    <!-- Spacer -->
                                    <TextBlock Grid.Column="3" />
                                    <!-- Unit B Value -->
                                    <TextBlock
                                        Grid.Column="4"
                                        FontSize="10"
                                        Foreground="#333"
                                        Text="{Binding DisplayValueB}"
                                        TextAlignment="Right">
                                        <TextBlock.FontWeight>
                                            <MultiBinding Converter="{StaticResource WinnerToBoldConverter}">
                                                <Binding Path="Winner" />
                                                <Binding Source="1" />
                                            </MultiBinding>
                                        </TextBlock.FontWeight>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Divider -->
                <Border BorderBrush="#DDD" BorderThickness="0,1,0,0" />

                <!-- Metrics Section -->
                <StackPanel Orientation="Vertical" Spacing="6">
                    <TextBlock
                        FontSize="10"
                        FontWeight="Bold"
                        Foreground="#666"
                        Text="DERIVED METRICS" />
                    <ItemsControl
                        x:Name="MetricsItemsControl"
                        ItemsSource="{Binding DerivedMetrics}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Unit A Value -->
                                    <TextBlock
                                        Grid.Column="0"
                                        FontSize="10"
                                        Foreground="#333"
                                        Text="{Binding DisplayValueA}">
                                        <TextBlock.FontWeight>
                                            <MultiBinding Converter="{StaticResource WinnerToBoldConverter}">
                                                <Binding Path="Winner" />
                                                <Binding Source="-1" />
                                            </MultiBinding>
                                        </TextBlock.FontWeight>
                                    </TextBlock>
                                    <!-- Metric Name -->
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="8,0,8,0"
                                        FontSize="10"
                                        Foreground="#666"
                                        Text="{Binding Name}" />
                                    <!-- Winner Indicator -->
                                    <TextBlock
                                        Grid.Column="2"
                                        FontSize="10"
                                        Foreground="#0A0"
                                        Text="{Binding WinnerLabel}" />
                                    <!-- Spacer -->
                                    <TextBlock Grid.Column="3" />
                                    <!-- Unit B Value -->
                                    <TextBlock
                                        Grid.Column="4"
                                        FontSize="10"
                                        Foreground="#333"
                                        Text="{Binding DisplayValueB}"
                                        TextAlignment="Right">
                                        <TextBlock.FontWeight>
                                            <MultiBinding Converter="{StaticResource WinnerToBoldConverter}">
                                                <Binding Path="Winner" />
                                                <Binding Source="1" />
                                            </MultiBinding>
                                        </TextBlock.FontWeight>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Divider -->
                <Border BorderBrush="#DDD" BorderThickness="0,1,0,0" />

                <!-- Validation Issues Section -->
                <StackPanel Orientation="Vertical" Spacing="6">
                    <TextBlock
                        FontSize="10"
                        FontWeight="Bold"
                        Foreground="#666"
                        Text="{Binding CombinedIssues.Count, StringFormat='VALIDATION ISSUES ({0})'}" />
                    <ItemsControl
                        MaxHeight="200"
                        ItemsSource="{Binding CombinedIssues}"
                        ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4,0,4" Orientation="Vertical">
                                    <StackPanel Margin="0,0,0,2" Orientation="Horizontal" Spacing="6">
                                        <TextBlock
                                            FontSize="9"
                                            FontWeight="Bold"
                                            Foreground="#C55"
                                            Text="{Binding Severity}" />
                                        <TextBlock
                                            FontSize="9"
                                            Foreground="#999"
                                            Text="{Binding UnitId}" />
                                    </StackPanel>
                                    <TextBlock
                                        FontSize="9"
                                        Foreground="#333"
                                        Text="{Binding Message}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        FontSize="8"
                                        Foreground="#060"
                                        FontStyle="Italic"
                                        Text="{Binding SuggestedAction}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock
                        FontSize="9"
                        Foreground="#999"
                        Text="No issues"
                        Visibility="{Binding CombinedIssues.Count, Converter={StaticResource IntToInvisibilityConverter}}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

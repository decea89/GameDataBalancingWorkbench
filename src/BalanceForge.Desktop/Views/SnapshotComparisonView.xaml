<UserControl x:Class="BalanceForge.Desktop.Views.SnapshotComparisonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#F5F7FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#E8EDF3" Padding="12,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" FontWeight="Bold" FontSize="13">
                    <Run Text="Roster Snapshot Diff  ·  Baseline: " />
                    <Run Text="{Binding BaselineFileName}" Foreground="#345B7E" />
                </TextBlock>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Margin="16,0,0,0" Foreground="#287D3C">
                        <Run Text="Added " />
                        <Run Text="{Binding AddedCount}" FontWeight="Bold" />
                    </TextBlock>
                    <TextBlock Margin="16,0,0,0" Foreground="#A33A2B">
                        <Run Text="Removed " />
                        <Run Text="{Binding RemovedCount}" FontWeight="Bold" />
                    </TextBlock>
                    <TextBlock Margin="16,0,0,0" Foreground="#9A6500">
                        <Run Text="Modified " />
                        <Run Text="{Binding ModifiedCount}" FontWeight="Bold" />
                    </TextBlock>
                    <TextBlock Margin="16,0,0,0" Foreground="#66717D">
                        <Run Text="Unchanged " />
                        <Run Text="{Binding UnchangedCount}" FontWeight="Bold" />
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Differences}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  RowDetailsVisibilityMode="VisibleWhenSelected"
                  GridLinesVisibility="Horizontal"
                  BorderThickness="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Change" Binding="{Binding ChangeKind}" Width="90" />
                <DataGridTextColumn Header="Unit" Binding="{Binding DisplayName}" Width="150" />
                <DataGridTextColumn Header="Fields" Binding="{Binding ChangedFieldCount}" Width="60" />
                <DataGridTextColumn Header="Summary" Binding="{Binding Summary}" Width="*" />
            </DataGrid.Columns>
            <DataGrid.RowDetailsTemplate>
                <DataTemplate>
                    <ItemsControl ItemsSource="{Binding Details}" Margin="100,5,10,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" BorderBrush="#D7DDE4" BorderThickness="1"
                                        CornerRadius="3" Padding="8,4" Margin="0,2">
                                    <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DataTemplate>
            </DataGrid.RowDetailsTemplate>
        </DataGrid>
    </Grid>
</UserControl>

